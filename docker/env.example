# ============================================
# Knife4j 文档聚合系统 - 环境变量配置
# 
# 使用方法:
#   1. 复制本文件为 .env: cp env.example .env
#   2. 根据实际情况修改配置
#   3. 启动服务: docker-compose up -d
# ============================================

# ============================================
# 镜像配置
# ============================================
# DockerHub 用户名
DOCKER_USERNAME=zhanglongjun
# 镜像版本
VERSION=latest

# ============================================
# 服务端口配置
# ============================================
# Doc Aggregator 服务端口
DOC_AGGREGATOR_PORT=9090
# AI 服务端口
AI_SERVICE_PORT=9100

# ============================================
# Nacos 配置
# 连接到你自己安装的 Nacos 实例
# ============================================
# Nacos 服务地址（host.docker.internal 表示宿主机）
NACOS_SERVER_ADDR=host.docker.internal:8848
# Nacos 用户名
NACOS_USERNAME=nacos
# Nacos 密码
NACOS_PASSWORD=nacos
# Nacos 命名空间
NACOS_NAMESPACE=public

# ============================================
# MongoDB 配置
# 连接到你自己安装的 MongoDB 实例
# ============================================
# MongoDB 连接字符串
MONGODB_URI=mongodb://admin:password123@host.docker.internal:27017/doc_aggregator?authSource=admin

# ============================================
# Ollama 配置
# 连接到你原生安装的 Ollama
# ============================================
# Ollama 服务地址
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 使用的模型名称
OLLAMA_MODEL=qwen2.5-coder:3b

# ============================================
# AI 功能配置
# ============================================
# 是否启用 AI 功能
KNIFE4J_AI_ENABLED=true
# AI 请求超时时间
KNIFE4J_AI_TIMEOUT=60s

# ============================================
# Java 运行时选项
# ============================================
# Doc Aggregator 服务 JVM 参数
DOC_AGGREGATOR_JAVA_OPTS=-Xmx1024m -Xms512m
# AI 服务 JVM 参数
AI_JAVA_OPTS=-Xmx512m -Xms256m
